name: CI

on:
  push:
    branches: [main]
  pull_request:

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        # Oldest supported (requires-python floor) and the pinned dev version.
        python-version: [CI_PYTHON_MATRIX_PLACEHOLDER]
    steps:
      - uses: actions/checkout@v5

      - name: Install uv
        uses: astral-sh/setup-uv@v10
        with:
          enable-cache: true
          python-version: ${{ matrix.python-version }}

      # --locked fails instead of silently re-resolving, so a stale uv.lock is
      # caught here rather than after a dependency has already drifted.
      - name: Install
        run: uv sync --locked

      - run: uv run ruff format --check .
      - run: uv run ruff check .
      - run: uv run ty check
# __IF:cli,lib,api,ml,rust__
      - run: uv run python scripts/sync_agent_docs.py --check
# __END__
      - run: uv run pytest --cov --cov-report=term-missing --cov-fail-under=80
