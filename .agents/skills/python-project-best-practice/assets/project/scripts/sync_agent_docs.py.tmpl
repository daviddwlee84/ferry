#!/usr/bin/env python3
"""Regenerate the CLI reference block in the agent-facing docs from --help.

The point: a package whose AGENTS.md drifts from its actual flags is worse
than no AGENTS.md, because an agent will confidently run a command that no
longer exists. This makes the docs a build artifact instead of prose someone
has to remember to update.

Rewrites everything between the BEGIN/END markers in each target file. Run
`--check` in CI to fail on drift.

Usage:
    python scripts/sync_agent_docs.py            # rewrite in place
    python scripts/sync_agent_docs.py --check    # exit 1 if stale, write nothing

Exit codes:
    0  in sync (or rewritten successfully)
    1  --check found drift
    3  a `--help` invocation failed
    4  a target file is missing its BEGIN/END markers
"""

from __future__ import annotations

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

PACKAGE = "PACKAGE_NAME_PLACEHOLDER"
BEGIN = "<!-- BEGIN CLI (generated by scripts/sync_agent_docs.py - do not edit) -->"
END = "<!-- END CLI -->"
TARGETS = (
    Path("AGENTS.md"),
    Path(".agents/skills/PROJECT_SLUG_PLACEHOLDER/SKILL.md"),
)

_ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]")


def _kebab(name: str) -> str:
    """tyro names a subcommand after the kebab-case of its dataclass."""
    return re.sub(r"(?<!^)(?=[A-Z])", "-", name).lower()


def _help_text(args: list[str]) -> str:
    env = {**os.environ, "NO_COLOR": "1", "COLUMNS": "96", "TERM": "dumb"}
    proc = subprocess.run(
        [sys.executable, "-m", f"{PACKAGE}.cli", *args, "--help"],
        capture_output=True,
        text=True,
        env=env,
        check=False,
    )
    if proc.returncode != 0:
        print(f"error: `{' '.join(args)} --help` exited {proc.returncode}", file=sys.stderr)
        print(proc.stderr, file=sys.stderr)
        raise SystemExit(3)
    return _ANSI.sub("", proc.stdout).rstrip()


def _subcommand_names() -> list[str]:
    from typing import get_args

    from PACKAGE_NAME_PLACEHOLDER.cli import Command

    return [_kebab(member.__name__) for member in get_args(Command)]


def _fence(argv: list[str]) -> str:
    invocation = " ".join(["PROJECT_SLUG_PLACEHOLDER", *argv, "--help"])
    return f"```console\n$ {invocation}\n{_help_text(argv)}\n```"


def render() -> str:
    blocks = [_fence([])]
    for name in _subcommand_names():
        blocks.append(f"### `{name}`\n\n{_fence([name])}")
    return "\n\n".join(blocks)


def splice(text: str, body: str, path: Path) -> str:
    if BEGIN not in text or END not in text:
        print(
            f"error: {path} has no BEGIN/END CLI markers; expected:\n  {BEGIN}\n  {END}",
            file=sys.stderr,
        )
        raise SystemExit(4)
    head, _, rest = text.partition(BEGIN)
    _, _, tail = rest.partition(END)
    return f"{head}{BEGIN}\n\n{body}\n\n{END}{tail}"


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--check", action="store_true", help="exit 1 on drift; write nothing")
    args = parser.parse_args()

    body = render()
    stale: list[Path] = []
    for path in TARGETS:
        if not path.exists():
            continue
        current = path.read_text(encoding="utf-8")
        updated = splice(current, body, path)
        if current == updated:
            continue
        stale.append(path)
        if not args.check:
            path.write_text(updated, encoding="utf-8")

    if args.check and stale:
        listing = ", ".join(str(p) for p in stale)
        print(f"error: CLI reference is stale in {listing}", file=sys.stderr)
        print("run `just docs-sync` and commit the result", file=sys.stderr)
        return 1
    if stale:
        print(f"updated {', '.join(str(p) for p in stale)}", file=sys.stderr)
    else:
        print("CLI reference already in sync", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
