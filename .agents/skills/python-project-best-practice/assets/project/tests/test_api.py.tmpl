"""Tests for the HTTP surface.

`with TestClient(app)` (not a bare TestClient) runs the lifespan, so logging
is configured exactly as it is in production.
"""

from __future__ import annotations

from fastapi.testclient import TestClient

from PACKAGE_NAME_PLACEHOLDER.api.app import app


def test_health() -> None:
    with TestClient(app) as client:
        response = client.get("/health")
    assert response.status_code == 200
    assert response.json()["status"] == "ok"


def test_greet() -> None:
    with TestClient(app) as client:
        response = client.post("/greet", json={"name": "ada", "times": 2})
    assert response.status_code == 200
    assert response.json()["lines"] == ["Hello, ada!", "Hello, ada!"]


def test_greet_rejects_zero_times() -> None:
    with TestClient(app) as client:
        response = client.post("/greet", json={"times": 0})
    assert response.status_code == 422
